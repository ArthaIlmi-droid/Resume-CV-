<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>ArZa Spa — Sentuhan Alami untuk Hidup yang Lebih Baik</title>
  <style>
/* Inlined styles.css - Modern Spa Website CSS */

:root {
  --primary-color: #6b9b5a;
  --secondary-color: #d4a574;
  --accent-color: #c9a77f;
  --dark-color: #2d3436;
  --light-color: #f5f3f0;
  --text-color: #333;
  --border-radius: 20px;
  --shadow: 0 8px 32px rgba(0,0,0,0.1);
  --transition: all 0.3s ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #f5f3f0 0%, #e8ddd6 100%);
  color: var(--text-color);
  line-height: 1.6;
  min-height: 100vh;
}

/* ===== SIDEBAR ===== */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 250px;
  height: 100vh;
  background: linear-gradient(180deg, var(--primary-color) 0%, rgba(107, 155, 90, 0.9) 100%);
  padding: 2rem 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  z-index: 1000;
  box-shadow: var(--shadow);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.nav-item {
  padding: 1rem 1.5rem;
  color: white;
  text-decoration: none;
  font-size: 1.1rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border-left: 4px solid transparent;
  position: relative;
}

/* ===== SIDEBAR LOGO ===== */
.sidebar-logo {
  padding: 1.5rem;
  text-align: center;
  border-bottom: 2px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 1rem;
}

.sidebar-logo-svg {
  width: 80px;
  height: 80px;
  margin: 0 auto 0.8rem;
  display: block;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
  transition: transform 0.3s ease;
}

.sidebar-logo-svg:hover {
  transform: scale(1.1) rotate(5deg);
}

.sidebar-logo-text {
  color: white;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 2px;
  margin: 0.5rem 0 0;
  text-transform: uppercase;
}

.sidebar-logo-subtitle {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.7rem;
  letter-spacing: 1px;
  margin-top: 0.3rem;
  font-weight: 400;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(255, 255, 255, 0.1);
  border-left-color: var(--secondary-color);
  padding-left: 2rem;
}

.nav-submenu {
  display: none;
  flex-direction: column;
  gap: 0;
  background: rgba(255, 255, 255, 0.05);
}

.nav-item.has-submenu:hover + .nav-submenu,
.nav-submenu:hover {
  display: flex;
}

.nav-submenu .nav-item {
  padding: 0.7rem 1.5rem 0.7rem 3rem;
  font-size: 0.95rem;
  font-weight: 400;
  border-left: none;
}

.nav-submenu .nav-item:hover {
  background: rgba(255, 255, 255, 0.15);
  padding-left: 3.5rem;
}

/* ===== MAIN LAYOUT ===== */
.main-content {
  margin-left: 250px;
  padding: 2rem;
}

.header {
  background: white;
  padding: 2rem 0;
  box-shadow: var(--shadow);
  margin-bottom: 2rem;
  border-radius: 0 0 var(--border-radius) var(--border-radius);
}

.header-content {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 2rem;
  align-items: center;
}

/* ===== LOGO & TAGLINE ===== */
.logo-section {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.logo-arza {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.logo-svg {
  width: 100px;
  height: 100px;
  color: var(--primary-color);
}

.forest-spa {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--primary-color);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.tagline h1 {
  font-size: 1.8rem;
  color: var(--primary-color);
  font-weight: 300;
  text-align: center;
  margin: 0;
}
/* Make subtitle sit beside the title on wider screens */
.tagline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.tagline-sub { margin-top: 0; }

/* ===== HEADER ACTIONS ===== */
.header-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
  justify-content: flex-end;
}

.btn-reservation,
.btn-location {
  padding: 0.7rem 1.2rem;
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: white;
  border: none;
  border-radius: 25px;
  cursor: pointer;
  font-weight: 600;
  transition: var(--transition);
  white-space: nowrap;
}

.btn-reservation:hover,
.btn-location:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.15);
}

/* ===== SEARCH BAR ===== */
.search-bar {
  display: flex;
  background: var(--light-color);
  border-radius: 25px;
  padding: 0.5rem;
  gap: 0.5rem;
  align-items: center;
  flex: 0 1 300px;
}

.search-input {
  flex: 1;
  border: none;
  background: transparent;
  padding: 0.5rem 1rem;
  font-size: 0.95rem;
  outline: none;
  color: var(--text-color);
}

.search-input::placeholder {
  color: #999;
}

.search-btn {
  background: var(--primary-color);
  color: white;
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1.2rem;
  transition: var(--transition);
}

.search-btn:hover {
  background: var(--secondary-color);
  transform: scale(1.1);
}

/* ===== PROFILE ICON ===== */
.profile-icon {
  position: relative;
}

.btn-profile {
  background: var(--secondary-color);
  color: white;
  border: none;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1.5rem;
  transition: var(--transition);
}

.btn-profile:hover {
  background: var(--primary-color);
  transform: scale(1.1);
}

/* ===== MODAL ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
  transition: var(--transition);
}

.modal.hidden {
  display: none;
}

.modal-content {
  background: white;
  padding: 2rem;
  border-radius: var(--border-radius);
  max-width: 500px;
  width: 90%;
  box-shadow: var(--shadow);
  position: relative;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.close-btn {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 2rem;
  cursor: pointer;
  color: #999;
  transition: var(--transition);
}

.close-btn:hover {
  color: var(--text-color);
}

.modal-content h3 {
  margin-bottom: 1rem;
  color: var(--primary-color);
}

/* ===== FORMS & INPUTS ===== */
.input-field {
  width: 100%;
  padding: 0.8rem;
  margin: 0.5rem 0;
  border: 2px solid var(--light-color);
  border-radius: 10px;
  font-size: 0.95rem;
  font-family: inherit;
  transition: var(--transition);
}

.input-field:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(107, 155, 90, 0.1);
}

.input-field::placeholder {
  color: #999;
}

/* ===== BUTTONS ===== */
.btn-primary,
.btn-secondary,
.btn-save,
.btn-edit {
  padding: 0.8rem 1.5rem;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
  transition: var(--transition);
  font-size: 0.95rem;
}

.btn-primary {
  background: var(--primary-color);
  color: white;
}

.btn-primary:hover {
  background: var(--secondary-color);
  transform: translateY(-2px);
}

.btn-secondary {
  background: var(--light-color);
  color: var(--text-color);
}

.btn-secondary:hover {
  background: #ddd;
}

.btn-save {
  background: var(--primary-color);
  color: white;
}

.btn-save:hover {
  background: var(--secondary-color);
}

.btn-edit,
.btn-edit-inline {
  background: var(--secondary-color);
  color: white;
  padding: 0.5rem 1rem;
  font-size: 0.85rem;
  margin-left: 0.5rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

.btn-edit:hover,
.btn-edit-inline:hover {
  background: var(--primary-color);
}

/* ===== SECTIONS ===== */
.section {
  margin-bottom: 3rem;
  padding: 2rem;
  background: white;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
}

.section h2 {
  color: var(--primary-color);
  margin-bottom: 2rem;
  font-size: 2.2rem;
  text-align: center;
}

/* ===== HERO CAROUSEL ===== */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--border-radius);
  margin-bottom: 2rem;
  height: 400px;
  background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));
}

.carousel-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.carousel-slide {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.8s ease-in-out;
  top: 0;
  left: 0;
}

.carousel-slide.active {
  opacity: 1;
}

.carousel-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.8;
}

.carousel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.4), rgba(212, 165, 116, 0.4));
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  z-index: 2;
}

.carousel-overlay h2 {
  font-size: 3rem;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.3);
  text-align: center;
  color: white;
  margin: 0;
  overflow: hidden;
  white-space: nowrap;
  position: relative;
  display: inline-block;
  width: 100%;
}

/* Auto-scrolling text animation */
.carousel-overlay h2.scroll-text {
  animation: scrollText 8s linear infinite;
}

@keyframes scrollText {
  0% {
    transform: translateX(100%);
  }
  100% {
    transform: translateX(-100%);
  }
}

/* Carousel Controls */
.carousel-controls {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  z-index: 10;
  align-items: center;
}

.carousel-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: var(--transition);
  border: 2px solid transparent;
}

.carousel-dot.active {
  background: white;
  transform: scale(1.2);
}

.carousel-dot:hover {
  background: rgba(255, 255, 255, 0.8);
}

/* Carousel Navigation Buttons */
.carousel-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  background: rgba(255, 255, 255, 0.3);
  color: white;
  border: none;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1.5rem;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
}

.carousel-nav:hover {
  background: rgba(255, 255, 255, 0.6);
  transform: translateY(-50%) scale(1.1);
}

.carousel-prev {
  left: 15px;
}

.carousel-next {
  right: 15px;
}

/* Slide Counter */
.slide-counter {
  position: absolute;
  top: 15px;
  right: 15px;
  background: rgba(107, 155, 90, 0.7);
  color: white;
  padding: 8px 12px;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  z-index: 10;
}

/* ===== WELCOME SECTION ===== */
.welcome-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-bottom: 3rem;
}

.welcome-box {
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.05), rgba(212, 165, 116, 0.05));
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid rgba(107, 155, 90, 0.1);
  transition: var(--transition);
}

.welcome-box:hover {
  border-color: var(--primary-color);
  box-shadow: 0 8px 24px rgba(107, 155, 90, 0.15);
}

.welcome-box h3 {
  color: var(--primary-color);
  margin-bottom: 1rem;
  font-size: 1.5rem;
}

.welcome-box p {
  color: var(--text-color);
  line-height: 1.8;
  margin-bottom: 1rem;
}

.editable-content {
  position: relative;
  padding-bottom: 0.5rem;
}

/* ===== SERVICES GRID ===== */
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.service-card {
  background: white;
  border: 2px solid var(--light-color);
  border-radius: var(--border-radius);
  padding: 2rem;
  text-align: center;
  cursor: pointer;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.1), rgba(212, 165, 116, 0.1));
  opacity: 0;
  transition: var(--transition);
  z-index: -1;
}

.service-card:hover {
  transform: translateY(-10px);
  border-color: var(--primary-color);
  box-shadow: 0 16px 40px rgba(107, 155, 90, 0.2);
}

.service-card:hover::before {
  opacity: 1;
}

.service-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
  display: inline-block;
}

.service-card h4 {
  color: var(--primary-color);
  margin-bottom: 0.5rem;
  font-size: 1.2rem;
}

.service-desc {
  color: #666;
  font-size: 0.9rem;
}

/* ===== VISION & MISSION ===== */
.vision-mission {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-bottom: 3rem;
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.05), rgba(212, 165, 116, 0.05));
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid rgba(107, 155, 90, 0.1);
}

.vm-box {
  padding: 1.5rem;
}

.vm-box h4 {
  color: var(--primary-color);
  margin-bottom: 1rem;
  font-size: 1.3rem;
}

.vm-box p {
  color: var(--text-color);
  line-height: 1.8;
}

/* ===== FOUNDER INFO ===== */
.founder-info {
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.05), rgba(212, 165, 116, 0.05));
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid rgba(107, 155, 90, 0.1);
  margin-bottom: 3rem;
}

.founder-info h3 {
  color: var(--primary-color);
  margin-bottom: 1.5rem;
  font-size: 1.5rem;
}

.founder-details p {
  margin: 0.8rem 0;
  color: var(--text-color);
  font-size: 1.05rem;
}

.founder-details strong {
  color: var(--primary-color);
}

/* ===== LOCATION & MAPS ===== */
.location-section {
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.05), rgba(212, 165, 116, 0.05));
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid rgba(107, 155, 90, 0.1);
}

.location-section h3 {
  color: var(--primary-color);
  margin-bottom: 1rem;
  font-size: 1.5rem;
}

.location-section p {
  color: var(--text-color);
  margin-bottom: 1.5rem;
  font-size: 1.05rem;
}

.maps-container {
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  margin-top: 1.5rem;
}

/* ===== SERVICE DETAILS ===== */
.service-details-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
}

.service-detail-card {
  background: white;
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid var(--light-color);
  transition: var(--transition);
  display: flex;
  flex-direction: column;
}

.service-detail-card:hover {
  border-color: var(--primary-color);
  box-shadow: var(--shadow);
  transform: translateY(-5px);
}

.service-detail-card h3 {
  color: var(--primary-color);
  margin-bottom: 1rem;
  font-size: 1.3rem;
}

.service-detail-card .price {
  color: var(--secondary-color);
  font-size: 1.8rem;
  font-weight: bold;
  margin: 1rem 0;
}

.service-detail-card p {
  color: #666;
  margin: 0.5rem 0;
  line-height: 1.6;
  flex-grow: 1;
  margin-bottom: 1rem;
}

.service-detail-card .btn-primary {
  align-self: flex-start;
  margin-top: auto;
}

/* ===== ABOUT SECTION ===== */
.about-content {
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.05), rgba(212, 165, 116, 0.05));
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid rgba(107, 155, 90, 0.1);
}

.about-content p {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--text-color);
  margin-bottom: 1.5rem;
}

/* ===== CONTACT FORM ===== */
.contact-form {
  max-width: 600px;
  margin: 0 auto;
  background: linear-gradient(135deg, rgba(107, 155, 90, 0.05), rgba(212, 165, 116, 0.05));
  padding: 2rem;
  border-radius: var(--border-radius);
  border: 2px solid rgba(107, 155, 90, 0.1);
}

.contact-form button {
  width: 100%;
  margin-top: 1rem;
}

.message {
  margin-top: 1rem;
  padding: 1rem;
  border-radius: 10px;
  text-align: center;
  font-weight: 600;
}

.message.success {
  background: rgba(107, 155, 90, 0.1);
  color: var(--primary-color);
}

.message.error {
  background: rgba(255, 0, 0, 0.1);
  color: red;
}

/* ===== GALLERY SECTION ===== */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: var(--border-radius);
  aspect-ratio: 1 / 1;
  cursor: pointer;
  box-shadow: var(--shadow);
  transition: var(--transition);
  background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));
}

.gallery-item:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: var(--transition);
}

.gallery-item:hover img {
  transform: scale(1.05);
  filter: brightness(0.8);
}

.gallery-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(107, 155, 90, 0.7);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  opacity: 0;
  transition: var(--transition);
  z-index: 5;
}

.gallery-item:hover .gallery-overlay {
  opacity: 1;
}

.gallery-overlay h3 {
  font-size: 1.3rem;
  margin-bottom: 0.5rem;
  text-align: center;
}

.gallery-overlay p {
  font-size: 0.9rem;
  text-align: center;
  max-width: 90%;
}

/* Gallery modal/lightbox */
.gallery-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 3000;
  padding: 1rem;
}

.gallery-modal.hidden {
  display: none;
}

.gallery-modal-content {
  position: relative;
  max-width: 90%;
  max-height: 90vh;
  background: white;
  border-radius: 10px;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.gallery-modal-image {
  width: 100%;
  height: auto;
  max-height: 80vh;
  object-fit: contain;
}

.gallery-close-btn {
  position: absolute;
  top: 15px;
  right: 15px;
  background: rgba(0,0,0,0.6);
  color: white;
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  font-size: 1.5rem;
  cursor: pointer;
  transition: var(--transition);
}

.gallery-close-btn:hover {
  background: rgba(0,0,0,0.9);
}

.gallery-view-more {
  text-align: center;
  margin-top: 2rem;
}

.gallery-view-more a {
  display: inline-block;
  padding: 0.8rem 2rem;
